---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'MSD Visualizer' } = Astro.props;
const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/campana', label: 'Campaña' },
  { href: '/brief', label: 'Brief (mock)' },
  { href: '/manifiesto', label: 'Manifiesto' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-100 antialiased">
    <header class="border-b border-neutral-800 bg-neutral-900/60 backdrop-blur sticky top-0 z-40">
      <div class="mx-auto flex max-w-7xl items-center gap-4 px-6 py-3">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <span class="grid size-8 place-items-center rounded-lg bg-gradient-to-br from-amber-400 to-pink-500 text-sm font-bold text-neutral-900">M</span>
          <span>msd-visualizer</span>
        </a>
        <nav class="ml-6 flex gap-1 text-sm">
          {nav.map((n) => (
            <a
              href={n.href}
              class:list={[
                'rounded-md px-3 py-1.5 transition-colors',
                isActive(n.href)
                  ? 'bg-neutral-800 text-white'
                  : 'text-neutral-400 hover:bg-neutral-800/60 hover:text-neutral-100',
              ]}
            >
              {n.label}
            </a>
          ))}
        </nav>
        <span class="ml-auto hidden rounded-full border border-neutral-700 px-3 py-1 text-xs text-neutral-400 sm:block">
          Fase 2 · maqueta sin auth/roles
        </span>
      </div>
    </header>
    <main class="mx-auto max-w-7xl px-6 py-8">
      <slot />
    </main>
    <footer class="mx-auto max-w-7xl px-6 pb-10 text-xs text-neutral-500">
      MSD — plataforma híbrida de marketing digital con IA · datos de demostración generados vía MCP de VectorCraft (PoC Fase 1)
    </footer>
  </body>
</html>
