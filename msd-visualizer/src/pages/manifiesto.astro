---
import Layout from '../layouts/Layout.astro';
import { loadManifest, loadAudit, kWc } from '../lib/campaign';

const manifest = loadManifest();
const part = manifest.parts[0];
const audit = loadAudit();

const limitBytes = manifest.editableFileLimitBytes;
const pct = Math.min(100, (part.sizeBytes / limitBytes) * 100);
const limitLabel = kWc(limitBytes);
---

<Layout title="Manifiesto · MSD Visualizer">
  <h1 class="text-2xl font-semibold tracking-tight">Manifiesto y bitácora (§14.5)</h1>
  <p class="mt-1 text-sm text-neutral-400">
    Trazabilidad real de la PoC: un documento editable con 20 artboards, hashes por export y auditoría de acciones.
  </p>

  <!-- tarjetas resumen -->
  <div class="mt-6 grid gap-4 sm:grid-cols-3">
    <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-5">
      <div class="text-xs uppercase tracking-wider text-neutral-500">part-001 · strategy</div>
      <div class="mt-2 text-sm">{part.strategy}</div>
      <div class="mt-4 text-xs text-neutral-500">partId {part.partId} · rev {part.revision}</div>
    </div>
    <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-5">
      <div class="text-xs uppercase tracking-wider text-neutral-500">peso editable</div>
      <div class="mt-2 text-2xl font-semibold text-amber-300">{kWc(part.sizeBytes)}</div>
      <div class="mt-3 h-2 w-full overflow-hidden rounded bg-neutral-800">
        <div class="h-full rounded bg-amber-400" style={`width:${Math.max(1, pct)}%`}></div>
      </div>
      <div class="mt-1 text-xs text-neutral-500">{pct.toFixed(2)}% del límite ({limitLabel})</div>
    </div>
    <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-5">
      <div class="text-xs uppercase tracking-wider text-neutral-500">integridad</div>
      <ul class="mt-2 space-y-1 text-xs text-neutral-300">
        <li>sha256 design: <code class="text-emerald-300">{part.sha256.slice(0, 16)}…</code></li>
        <li>exports: {manifest.exports.length} con sha256 y {manifest.exports[0].dimensions}</li>
        <li>warnings registrados: 0</li>
      </ul>
    </div>
  </div>

  <!-- items -->
  <h2 class="mt-10 font-semibold">piezas en el documento (artwork íntegro)</h2>
  <div class="mt-3 overflow-x-auto rounded-xl border border-neutral-800">
    <table class="w-full min-w-[720px] text-sm">
      <thead class="bg-neutral-950 text-left text-xs uppercase tracking-wider text-neutral-500">
        <tr>
          <th class="px-4 py-2">pieceId</th>
          <th class="px-4 py-2">artboard</th>
          <th class="px-4 py-2">board</th>
          <th class="px-4 py-2">canal</th>
          <th class="px-4 py-2">formato</th>
          <th class="px-4 py-2">paleta</th>
          <th class="px-4 py-2">tema</th>
        </tr>
      </thead>
      <tbody>
        {part.items.map((it) => (
          <tr class="border-t border-neutral-800/60 hover:bg-neutral-900/60">
            <td class="px-4 py-1.5 font-mono text-xs text-amber-300">{it.pieceId}</td>
            <td class="px-4 py-1.5 text-neutral-500">{it.artboard}</td>
            <td class="px-4 py-1.5">{it.boardName}</td>
            <td class="px-4 py-1.5">{it.channel}</td>
            <td class="px-4 py-1.5 text-neutral-400">{it.formatSize}</td>
            <td class="px-4 py-1.5">{it.palette}</td>
            <td class="px-4 py-1.5">{it.theme}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- bitácora -->
  <h2 class="mt-10 font-semibold">audit-log.jsonl</h2>
  <div class="mt-3 space-y-2">
    {audit.map((e) => (
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-2.5 font-mono text-xs">
        <span class="text-neutral-500">{e.timestamp}</span>
        <span class="rounded bg-neutral-800 px-1.5 py-0.5 text-emerald-300">{e.action}</span>
        <span class="text-sky-300">{e.actorId}</span>
        <span class="text-neutral-400">
          {Object.entries(e)
            .filter(([k]) => !['timestamp', 'action', 'actorId', 'note'].includes(k))
            .map(([k, v]) => `${k}=${JSON.stringify(v)}`)
            .join('  ')}
        </span>
        {e.note ? <span class="w-full text-neutral-500">↳ {e.note}</span> : ''}
      </div>
    ))}
  </div>
</Layout>
